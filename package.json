{
  "name": "parity-desktop",
  "version": "0.9.0",
  "private": true,
  "description": "Local-first core facility requests, billing review and campus reporting",
  "author": "Parity",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:start": "npm run desktop:prepare && electron .",
    "desktop:test": "npm run desktop:prepare && electron . --smoke-test",
    "desktop:mac": "npm run desktop:prepare && electron-builder --mac zip --arm64 --publish never",
    "desktop:win": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish never",
    "agent:train": "node agent/train.cjs",
    "agent:test": "node tests/agent.test.cjs",
    "agent:practice": "node agent/practice.cjs",
    "desktop:test:home": "npm run desktop:prepare && electron . --home-smoke-test",
    "desktop:icons": "electron desktop/build-icons.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.parity.desktop",
    "productName": "Parity",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/credential-preload.cjs",
      "desktop/credential.html",
      "desktop/credential.js",
      "desktop/credential.css",
      "desktop/web/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "brand/app-icon.icns",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis",
      "icon": "brand/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Parity-${version}-${os}-${arch}.${ext}"
  }
}
