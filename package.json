{
  "name": "labro-desktop", "version": "0.5.0", "private": true,
  "description": "Local-first core facility requests, billing review and campus reporting",
  "author": "LaBro", "main": "desktop/main.cjs",
  "scripts": {
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:start": "npm run desktop:prepare && electron .",
    "desktop:test": "npm run desktop:prepare && electron . --smoke-test",
    "desktop:mac": "npm run desktop:prepare && electron-builder --mac zip --arm64 --publish never",
    "desktop:win": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {"electron": "45.2.3", "electron-builder": "26.18.0"},
  "build": {
    "appId": "org.labro.desktop", "productName": "LaBro",
    "directories": {"output": "release"},
    "files": ["desktop/main.cjs", "desktop/preload.cjs", "desktop/web/**/*", "package.json"],
    "mac": {"category": "public.app-category.productivity", "identity": null},
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true},
    "artifactName": "LaBro-${version}-${os}-${arch}.${ext}"
  }
}
